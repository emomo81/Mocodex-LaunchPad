# Supabase — copy to .env.local for local development.
# Use the Project URL and the public anon/publishable key only.
# Never commit the service-role key; it belongs in server-side runtime config.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
